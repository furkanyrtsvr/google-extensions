{
  "action": {
    "default_icon": {
      "128": "icon.png",
      "16": "icon.png",
      "48": "icon.png"
    }
  },
  "content_scripts": [
    {
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "matches": [
        "https://github.com/*"
      ]
    },
    {
      "all_frames": true,
      "js": [
        "tracespace-bridge.js"
      ],
      "matches": [
        "https://tracespace.io/view/*"
      ]
    },
    {
      "all_frames": true,
      "js": [
        "kicanvas-bridge.js"
      ],
      "matches": [
        "https://kicanvas.org/*"
      ],
      "run_at": "document_start"
    },
    {
      "all_frames": true,
      "js": [
        "convert3d-bridge.js"
      ],
      "matches": [
        "https://convert3d.org/*"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "enabled": true,
        "id": "ruleset_1",
        "path": "rules.json"
      }
    ]
  },
  "description": "Powerful all-in-one previewer for Video, Audio, Excel, 3D, and PCB files directly in GitHub.",
  "host_permissions": [
    "https://github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://tracespace.io/*",
    "https://kicanvas.org/*",
    "https://convert3d.org/*"
  ],
  "icons": {
    "128": "icon.png",
    "16": "icon.png",
    "48": "icon.png"
  },
  "key": "",
  "manifest_version": 3,
  "name": "Viewer Helper for GitHub",
  "permissions": [
    "declarativeNetRequest"
  ],
  "update_url": "https://clients2.google.com/service/update2/crx",
  "version": "1.1.0",
  "web_accessible_resources": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "resources": [
        "assets/*",
        "viewer.html"
      ]
    }
  ]
}
