{
  "action": {
    "default_icon": {
      "128": "icon_v2.png",
      "16": "icon_v2.png",
      "48": "icon_v2.png"
    },
    "default_popup": "popup.html",
    "default_title": "BOM List Helper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "matches": [
        "*://*.digikey.com/*",
        "*://*.digikey.tr/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "description": "Create custom BOM lists directly from DigiKey product pages.",
  "host_permissions": [
    "https://*.digikey.com/*",
    "https://*.digikey.tr/*",
    "https://mm.digikey.com/*",
    "*://*.digikey.com/*",
    "*://*.digikey.tr/*",
    "<all_urls>"
  ],
  "icons": {
    "128": "icon_v2.png",
    "16": "icon_v2.png",
    "48": "icon_v2.png"
  },
  "key": "",
  "manifest_version": 3,
  "name": "BOM List Helper for DigiKey",
  "permissions": [
    "storage",
    "activeTab",
    "downloads",
    "scripting"
  ],
  "update_url": "https://clients2.google.com/service/update2/crx",
  "version": "1.0.0",
  "web_accessible_resources": [
    {
      "matches": [
        "*://*.digikey.com/*",
        "*://*.digikey.tr/*"
      ],
      "resources": [
        "icon_v2.png"
      ]
    }
  ]
}
