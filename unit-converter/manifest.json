{
  "action": {
    "default_icon": {
      "128": "icon_128x128.png",
      "16": "icon_16x16.png",
      "48": "icon_48x48.png"
    },
    "default_popup": "popup.html",
    "default_title": "Open Unit Converter"
  },
  "content_scripts": [
    {
      "all_frames": true,
      "js": [
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "description": "A professional, floating engineering unit converter for Chrome.",
  "icons": {
    "128": "icon_128x128.png",
    "16": "icon_16x16.png",
    "48": "icon_48x48.png"
  },
  "key": "",
  "manifest_version": 3,
  "name": "Unit Converter",
  "options_page": "options.html",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "update_url": "https://clients2.google.com/service/update2/crx",
  "version": "1.1.0",
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "styles.css"
      ]
    }
  ]
}
